generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id @default(cuid())
 wallet String @unique
 displayName String?
 sessions AuthSession[]
 createdAt DateTime @default(now())
 submissions Submission[]
 entries LedgerEntry[]
}
model Campaign {
 id String @id @default(cuid())
 title String
 description String
 status String @default("DRAFT")
 startsAt DateTime?
 endsAt DateTime?
 createdAt DateTime @default(now())
 budgetWei Decimal @default(0) @db.Decimal(78,0)
 allocatedWei Decimal @default(0) @db.Decimal(78,0)
 rewards LedgerEntry[]
 tasks Task[]
}
model Task {
 id String @id @default(cuid())
 campaignId String
 campaign Campaign @relation(fields:[campaignId],references:[id])
 title String
 platform String
 kind String
 enabled Boolean @default(false)
 policyReviewed Boolean @default(false)
 verification Json?
 submissions Submission[]
 rewardWei Decimal @default(0) @db.Decimal(78,0)
}
model LedgerEntry {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 amountWei Decimal @db.Decimal(78,0)
 idempotencyKey String @unique
 reason String
 status LedgerStatus @default(AVAILABLE)
 campaignId String?
 campaign Campaign? @relation(fields:[campaignId],references:[id])
 submissionId String? @unique
 submission Submission? @relation(fields:[submissionId],references:[id])
 events LedgerEvent[]
 createdAt DateTime @default(now())
}
model AuditEvent {
 id String @id @default(cuid())
 actor String
 action String
 resource String
 createdAt DateTime @default(now())
}

enum AdminRole {
 OWNER
 ADMIN
 REVIEWER
}
model Admin {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role AdminRole @default(REVIEWER)
 enabled Boolean @default(true)
 totpEncrypted String?
 lastTotpStep Int @default(-1)
 createdAt DateTime @default(now())
 sessions AuthSession[]
}
model AuthSession {
 id String @id
 userId String?
 user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
 adminId String?
 admin Admin? @relation(fields:[adminId],references:[id],onDelete:Cascade)
 mfaVerified Boolean @default(false)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
 @@index([adminId])
}

enum LedgerStatus {
 PENDING
 AVAILABLE
 RESERVED
 CLAIMED
 REJECTED
}
enum SubmissionStatus {
 PENDING
 APPROVED
 REJECTED
}
model Submission {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 taskId String
 task Task @relation(fields:[taskId],references:[id])
 proof String
 status SubmissionStatus @default(PENDING)
 reviewNote String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 reward LedgerEntry?
 @@unique([userId,taskId])
}
model LedgerEvent {
 id String @id @default(cuid())
 ledgerId String
 ledger LedgerEntry @relation(fields:[ledgerId],references:[id])
 fromStatus LedgerStatus?
 toStatus LedgerStatus
 actor String
 reason String
 createdAt DateTime @default(now())
 @@index([ledgerId])
}
