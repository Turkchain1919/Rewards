generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id @default(cuid())
 wallet String @unique
 displayName String?
 socialRewardIdentities SocialRewardIdentity[]
 socialChallenges SocialChallenge[]
 sessions AuthSession[]
 createdAt DateTime @default(now())
 socialAccounts SocialAccount[]
 socialLinkStates SocialLinkState[]
 submissions Submission[]
 claims ClaimAuthorization[]
 entries LedgerEntry[]
}
model Campaign {
 id String @id @default(cuid())
 title String
 description String
 status String @default("DRAFT")
 startsAt DateTime?
 endsAt DateTime?
 archivedAt DateTime?
 createdAt DateTime @default(now())
 networkId String?
 network BlockchainNetwork? @relation(fields:[networkId],references:[id])
 budgetWei Decimal @default(0) @db.Decimal(78,0)
 allocatedWei Decimal @default(0) @db.Decimal(78,0)
 rewards LedgerEntry[]
 tasks Task[]
 @@index([archivedAt])
}
model Task {
 id String @id @default(cuid())
 campaignId String
 campaign Campaign @relation(fields:[campaignId],references:[id])
 title String
 platform String
 kind String
 enabled Boolean @default(false)
 officialAccountId String?
 officialAccount OfficialSocialAccount? @relation(fields:[officialAccountId],references:[id])
 configurationRequired Boolean @default(false)
 targetUrl String?
 policyReviewed Boolean @default(false)
 verification Json?
 localizedContent Json?
 startsAt DateTime?
 endsAt DateTime?
 publishedAt DateTime?
 archivedAt DateTime?
 submissions Submission[]
 socialTaskCode String?
 targetObjectId String?
 timezone String @default("UTC")
 budgetWei Decimal? @db.Decimal(78,0)
 allocatedWei Decimal @default(0) @db.Decimal(78,0)
 socialIdentities SocialRewardIdentity[]
 socialChallenges SocialChallenge[]
 rewardWei Decimal @default(0) @db.Decimal(78,0)
 @@index([campaignId, archivedAt])
}
model LedgerEntry {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 amountWei Decimal @db.Decimal(78,0)
 idempotencyKey String @unique
 reason String
 networkId String?
 network BlockchainNetwork? @relation(fields:[networkId],references:[id])
 status LedgerStatus @default(AVAILABLE)
 campaignId String?
 campaign Campaign? @relation(fields:[campaignId],references:[id])
 submissionId String? @unique
 submission Submission? @relation(fields:[submissionId],references:[id])
 claimId String?
 claim ClaimAuthorization? @relation(fields:[claimId],references:[id])
 events LedgerEvent[]
 createdAt DateTime @default(now())
}
model AuditEvent {
 id String @id @default(cuid())
 actor String
 action String
 resource String
 createdAt DateTime @default(now())
}

enum AdminRole {
 OWNER
 ADMIN
 REVIEWER
}
model Admin {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role AdminRole @default(REVIEWER)
 enabled Boolean @default(true)
 totpEncrypted String?
 lastTotpStep Int @default(-1)
 createdAt DateTime @default(now())
 sessions AuthSession[]
}
model AuthSession {
 id String @id
 userId String?
 user User? @relation(fields:[userId],references:[id],onDelete:Cascade)
 adminId String?
 admin Admin? @relation(fields:[adminId],references:[id],onDelete:Cascade)
 mfaVerified Boolean @default(false)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([expiresAt])
 @@index([adminId])
}

enum LedgerStatus {
 PENDING
 AVAILABLE
 RESERVED
 CLAIMED
 REJECTED
}
enum SubmissionStatus {
 PENDING
 APPROVED
 REJECTED
}
model Submission {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 taskId String
 task Task @relation(fields:[taskId],references:[id])
 proof String
 status SubmissionStatus @default(PENDING)
 reviewNote String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 reward LedgerEntry?
 @@unique([userId,taskId])
}
model LedgerEvent {
 id String @id @default(cuid())
 ledgerId String
 ledger LedgerEntry @relation(fields:[ledgerId],references:[id])
 fromStatus LedgerStatus?
 toStatus LedgerStatus
 actor String
 reason String
 createdAt DateTime @default(now())
 @@index([ledgerId])
}

model SocialAccount {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 provider String
 providerAccountId String
 accountName String
 credentialId String?
 credential Credential? @relation(fields:[credentialId],references:[id])
 lastRefreshAt DateTime?
 lastError String?
 encryptedTokens String?
 scopes String[]
 expiresAt DateTime?
 createdAt DateTime @default(now())
 @@unique([userId,provider])
 @@unique([provider,providerAccountId])
}

model IntegrationSetting {
 platform String @id
 authMode String @default("oauth")
 requestedScopes String[] @default([])
 webhookEnabled Boolean @default(false)
 webhookVerifiedAt DateTime?
 credentialsUpdatedAt DateTime?
 enabledOverride Boolean?
 callbackUrl String?
 graphVersion String?
 disabled Boolean @default(false)
 name String?
 profileUrl String?
 accountId String?
 defaultTargetUrl String?
 version Int @default(0)
 lastTestAt DateTime?
 lastSuccessAt DateTime?
 lastTestStatus String?
 lastError String?
 updatedAt DateTime @updatedAt
}

model BlockchainNetwork {
 id String @id @default(cuid())
 networkKey String @unique
 networkName String
 chainId String @unique
 config Json
 enabled Boolean @default(false)
 isActive Boolean @default(false)
 version Int @default(0)
 verification Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 campaigns Campaign[]
 claims ClaimAuthorization[]
 entries LedgerEntry[]
}
model ConfigDocument {
 key String @id
 value Json
 version Int @default(0)
 updatedAt DateTime @updatedAt
}
model Credential {
 id String @id @default(cuid())
 scope String
 ownerId String
 kind String
 ciphertext String?
 version Int @default(0)
 revokedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 personalAccounts SocialAccount[]
 officialAccounts OfficialSocialAccount[]
 @@unique([scope,ownerId,kind])
}

model OfficialSocialAccount {
 id String @id @default(cuid())
 platform String
 accountType String @default("PROFILE")
 name String
 username String @default("")
 accountId String @default("")
 profileUrl String @default("")
 defaultTargetUrl String @default("")
 enabled Boolean @default(false)
 isDefault Boolean @default(false)
 connectionStatus String @default("UNCONFIGURED")
 credentialId String?
 credential Credential? @relation(fields:[credentialId],references:[id])
 metadataOverride Boolean @default(false)
 version Int @default(0)
 sourceKey String? @unique
 lastSuccessAt DateTime?
 lastError String?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
 @@index([platform])
}

model SocialPlatform {
 key String @id
 name String
 connector String
 enabled Boolean @default(true)
 createdAt DateTime @default(now())
}

model SocialLinkState {
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 provider String
 generation Int @default(0)
 @@id([userId,provider])
}

model ClaimAuthorization {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 networkId String
 network BlockchainNetwork @relation(fields:[networkId],references:[id])
 recipient String
 amountWei Decimal @db.Decimal(78,0)
 nonce String @unique
 deadline DateTime
 createdBlock String
 lastScannedBlock String?
 contractAddress String
 bytecodeHash String
 authorization Json
 status String @default("PREPARED")
 transactionHash String?
 confirmedAt DateTime?
 lastError String?
 checkedAt DateTime?
 createdAt DateTime @default(now())
 entries LedgerEntry[]
 @@index([networkId,status])
}

model HeroVisual {
 id String @id @default("homepage")
 filename String
 contentType String @default("image/gif")
 bytes Bytes
 size Int
 width Int
 height Int
 frameCount Int
 sha256 String
 published Boolean @default(false)
 enabled Boolean @default(false)
 updatedAt DateTime @updatedAt
}

model SocialRewardIdentity {
 id String @id @default(cuid())
 taskId String
 task Task @relation(fields:[taskId],references:[id],onDelete:Restrict)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 provider String
 accountHash String
 createdAt DateTime @default(now())
 @@unique([taskId,provider,accountHash])
 @@index([userId])
}
model SocialWebhookReceipt {
 id String @id @default(cuid())
 platform String
 eventId String
 eventType String
 bodyHash String
 actorHash String?
 targetObjectId String?
 receivedAt DateTime @default(now())
 occurredAt DateTime
 expiresAt DateTime
 challenges SocialChallenge[]
 @@unique([platform,eventId])
 @@index([expiresAt])
}
model SocialChallenge {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 taskId String
 task Task @relation(fields:[taskId],references:[id],onDelete:Restrict)
 officialAccountId String
 officialVersion Int
 providerAccountHash String
 tokenHash String @unique
 expiresAt DateTime
 verifiedAt DateTime?
 consumedAt DateTime?
 receiptId String?
 receipt SocialWebhookReceipt? @relation(fields:[receiptId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 @@index([expiresAt])
 @@index([userId,taskId])
}
