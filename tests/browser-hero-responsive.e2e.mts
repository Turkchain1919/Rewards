import assert from 'node:assert/strict';import{createRequire}from'node:module';import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{createHash}from'node:crypto';
const require=createRequire(import.meta.url),pw=require(process.env.HERO_PLAYWRIGHT||'../.runtime/browser-tools/node_modules/playwright'),name=process.env.HERO_BROWSER||'chromium',origin=process.env.HERO_ORIGIN||'http://127.0.0.1:18480',folder=process.env.HERO_EVIDENCE||'.runtime/hero-responsive-v052',fixture=process.env.HERO_FIXTURE||folder+'/original.gif';mkdirSync(folder,{recursive:true});const bytes=readFileSync(fixture),engine=name==='chrome'||name==='msedge'?'chromium':name,browser=await pw[engine].launch({headless:true,...(engine==='chromium'?{args:['--no-sandbox']}:{}),...(name==='chrome'||name==='msedge'?{channel:name}:{})}),results=[];
try{for(const width of[1440,820,390])for(const lang of['tr','en']){const page=await browser.newPage({viewport:{width,height:1000},reducedMotion:'no-preference'}),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.route('**/api/**',route=>route.request().method()==='GET'?route.continue():route.abort());if(process.env.HERO_USE_ACTUAL!=='true'){await page.route('**/api/hero',r=>r.fulfill({contentType:'application/json',body:JSON.stringify({url:'/api/hero/'+'a'.repeat(64),width:440,height:440})}));await page.route('**/api/hero/*',r=>r.fulfill({contentType:'image/gif',body:bytes}));}await page.goto(origin+'/'+lang);const image=page.locator('.hero-gif');await page.waitForFunction(()=>{const i=document.querySelector('.hero-gif');return i instanceof HTMLImageElement&&i.complete&&i.naturalWidth>0;});const geometry=await image.evaluate(i=>{const r=i.getBoundingClientRect(),s=getComputedStyle(i);return{w:r.width,h:r.height,nw:i.naturalWidth,nh:i.naturalHeight,fit:s.objectFit,radius:s.borderRadius,clip:s.clipPath,border:s.borderWidth}});assert.equal(geometry.fit,'contain');assert.equal(geometry.radius,'0px');assert.equal(geometry.clip,'none');assert.equal(geometry.border,'0px');assert.ok(Math.abs(geometry.w/geometry.h-geometry.nw/geometry.nh)<.01);assert.ok(geometry.w<=440);assert.equal(await page.locator('.hero .orb').count(),0);assert.equal(await page.getByRole('button',{name:/GIF animasyonunu oynat/}).count(),0);const hashes=[];for(let n=0;n<5;n++){await page.waitForTimeout(190);hashes.push(createHash('sha256').update(await image.screenshot()).digest('hex'));}assert.ok(new Set(hashes).size>=2,'GIF pixels must change over time');assert.equal(await page.locator('.hero-motion-control,.hero-static').count(),0);await page.emulateMedia({reducedMotion:'reduce'});assert.equal(await image.evaluate(i=>getComputedStyle(i).visibility),'visible');const reducedHashes=[];for(let n=0;n<3;n++){await page.waitForTimeout(190);reducedHashes.push(createHash('sha256').update(await image.screenshot()).digest('hex'));}assert.ok(new Set(reducedHashes).size>=2,'GIF remains animated without controls');await page.emulateMedia({reducedMotion:'no-preference'});assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2));assert.deepEqual(errors,[]);await page.screenshot({path:folder+'/'+name+'-'+width+'-'+lang+'.png',fullPage:true});results.push({width,lang,pixelFrames:new Set(hashes).size,geometry,autoplayWithoutControls:true,passed:true});await page.close();}writeFileSync(folder+'/'+name+'-results.json',JSON.stringify({browser:name,version:browser.version(),actualPublicAsset:process.env.HERO_USE_ACTUAL==='true',results},null,2));console.log('PASS '+name+' '+results.length+' viewport/locale cases with changing GIF pixels, native ratio and automatic playback without controls');}finally{await browser.close();}
