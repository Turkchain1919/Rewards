import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {writeFileSync} from 'node:fs';
import {Wallet,getBytes} from 'ethers';
import {PrismaClient} from '@prisma/client';
import {PrismaPg} from '@prisma/adapter-pg';
assert.equal(process.env.APP_ENV,'test');assert.match(process.env.DATABASE_URL||'',/rewards_test/);
const require=createRequire(new URL('../.runtime/browser-tools/package.json',import.meta.url)),{chromium}=require('playwright'),origin='http://127.0.0.1:18480';
const browser=await chromium.launch({headless:true,args:['--no-sandbox']}),db=new PrismaClient({adapter:new PrismaPg({connectionString:process.env.DATABASE_URL})}),createdWallets=[],results=[];
const android='Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 Chrome/130.0 Mobile Safari/537.36',ios='Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 Version/18.0 Mobile/15E148 Safari/604.1';
try{
 // SPA language updates must not require reload and must preserve anchors/navigation history.
 for(const width of [1440,390]){
  const page=await browser.newPage({viewport:{width,height:1000}}),errors=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(origin+'/tr/dashboard#wallet-access');await page.getByRole('heading',{name:'Hoş geldin.',exact:true}).waitFor();await page.evaluate(()=>{(window as unknown as {documentWitness:string}).documentWitness='same-document';});
  await page.getByRole('combobox',{name:'Language',exact:true}).selectOption('en');await page.getByRole('heading',{name:'Welcome.',exact:true}).waitFor();await page.waitForURL('**/en/dashboard#wallet-access');assert.equal(await page.locator('html').getAttribute('lang'),'en');assert.equal(await page.locator('header nav a').first().getAttribute('href'),'/en/dashboard');assert.equal(await page.evaluate(()=>(window as unknown as {documentWitness:string}).documentWitness),'same-document');
  await page.goBack();await page.getByRole('heading',{name:'Hoş geldin.',exact:true}).waitFor();assert.equal(await page.locator('html').getAttribute('lang'),'tr');await page.goForward();await page.getByRole('heading',{name:'Welcome.',exact:true}).waitFor();assert.deepEqual(errors,[]);await page.close();results.push({scenario:'locale-history-no-reload',width,passed:true});
 }
 // External phone browsers have no injected provider even if the app is installed.
 for(const userAgent of [android,ios])for(const lang of ['tr','en']){
  const page=await browser.newPage({viewport:{width:390,height:900},userAgent,isMobile:true,hasTouch:true}),posts=[];page.on('request',r=>{if(r.method()==='POST'&&new URL(r.url()).pathname.startsWith('/api/auth/'))posts.push(r.url());});await page.goto(origin+'/'+lang+'/dashboard');const link=page.getByRole('link',{name:lang==='tr'?'MetaMask uygulamasında aç ↗':'Open in MetaMask ↗',exact:true});await link.waitFor();assert.equal(await link.getAttribute('href'),'https://link.metamask.io/dapp/127.0.0.1:18480/'+lang+'/dashboard#wallet-access');assert.equal(posts.length,0);assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2));await page.screenshot({path:'.runtime/mobile-locale-v052/mobile-'+lang+'-'+(userAgent===ios?'ios':'android')+'.png',fullPage:true});await page.close();results.push({scenario:'official-mobile-dapp-link',lang,device:userAgent===ios?'ios':'android',passed:true,nativeAppLaunchTested:false});
 }
 // A simulated EIP-1193 provider signs real TEST SIWE challenges; never requests a transaction.
 const config=await(await fetch(origin+'/api/config')).json();
 for(const mobile of [false,true])for(const lang of ['tr','en']){
  const wallet=Wallet.createRandom();let fixtureChain=mobile&&lang==='en'&&config.wallet.autoSwitch&&config.wallet.autoAdd?'0x1':config.chainIdHex;createdWallets.push(wallet.address.toLowerCase());const context=await browser.newContext({viewport:{width:mobile?390:1440,height:1000},...(mobile?{userAgent:android,isMobile:true,hasTouch:true}:{})}),page=await context.newPage(),calls=[],posts=[],errors=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(r.method()==='POST'&&new URL(r.url()).pathname.startsWith('/api/auth/'))posts.push(new URL(r.url()).pathname);});
  await page.exposeFunction('fixtureWalletRequest',async(args:{method:string;params?:unknown[]})=>{calls.push(args.method);if(args.method==='eth_requestAccounts')return [wallet.address];if(args.method==='eth_chainId')return fixtureChain;if(args.method==='wallet_addEthereumChain'){assert.equal((args.params?.[0]as {chainId:string}).chainId,config.chainIdHex);fixtureChain=config.chainIdHex;return null;}if(args.method==='personal_sign'){assert.equal(args.params?.[1],wallet.address);return wallet.signMessage(getBytes(String(args.params?.[0])));}throw Error('Unexpected wallet method: '+args.method);});
  await page.addInitScript(`window.ethereum={request:function(args){if(args.method==='wallet_switchEthereumChain'&&${JSON.stringify(fixtureChain!==config.chainIdHex)})return Promise.reject(Object.assign(new Error('Unknown chain'),{code:4902}));if(window.rejectFixture)return Promise.reject(Object.assign(new Error('User rejected'),{code:4001}));if(window.delayFixture&&args.method==='eth_requestAccounts')return new Promise(function(resolve){window.finishFixture=function(){resolve([${JSON.stringify(wallet.address)}]);};});return window.fixtureWalletRequest(args);}};`);

  await page.goto(origin+'/'+lang+'/dashboard');const connect=()=>page.getByRole('button',{name:lang==='tr'?'MetaMask ile güvenli giriş ↗':'Secure sign-in with MetaMask ↗',exact:true}).click();
  await page.evaluate(()=>{(window as unknown as {rejectFixture:boolean}).rejectFixture=true;});await connect();await page.getByRole('status').filter({hasText:lang==='tr'?'Cüzdan isteği reddedildi.':'Wallet request rejected.'}).waitFor().catch(async error=>{console.error({lang,mobile,calls,posts,errors,walletUi:await page.locator('.wallet').innerText()});await page.screenshot({path:'.runtime/mobile-locale-v052/wallet-failure.png',fullPage:true});throw error;});assert.equal(posts.length,0);
  await page.evaluate(()=>{const w=window as unknown as {rejectFixture:boolean;delayFixture:boolean};w.rejectFixture=false;w.delayFixture=true;});await connect();await page.getByRole('button',{name:lang==='tr'?'Bağlantıyı iptal et':'Cancel connection',exact:true}).click();await page.evaluate(()=>{const w=window as unknown as {finishFixture:()=>void;delayFixture:boolean};w.finishFixture();w.delayFixture=false;});await page.getByRole('status').filter({hasText:lang==='tr'?'Cüzdan bağlantısı iptal edildi.':'Wallet connection cancelled.'}).waitFor();assert.equal(posts.length,0);
  await connect();await page.getByLabel(lang==='tr'?'Profil adı':'Profile name',{exact:true}).waitFor();assert.ok((await page.locator('.wallet').innerText()).toLowerCase().includes(wallet.address.toLowerCase()));assert.deepEqual(posts,['/api/auth/challenge','/api/auth/verify']);assert.equal(calls.filter(m=>m==='personal_sign').length,1);assert.equal(calls.some(m=>/sendTransaction|signTransaction/.test(m)),false);assert.deepEqual(errors,[]);await context.close();results.push({scenario:'real-test-siwe-with-simulated-provider',mobile,lang,noTransfers:true,rejectAndCancel:true,passed:true});
 }
 // Reduced-motion keeps a still frame visible rather than hiding the uploaded visual.
 const fixture=Buffer.from('R0lGODlhAQABAPAAAP8AAP///yH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==','base64');
 for(const width of [1440,390])for(const reducedMotion of ['no-preference','reduce']){
  const page=await browser.newPage({viewport:{width,height:1000},reducedMotion}),errors=[];let published=true,version='1';page.on('pageerror',e=>errors.push(e.message));
  await page.route('**/api/hero',route=>route.fulfill({status:200,contentType:'application/json',body:JSON.stringify({url:published?'/api/hero/'+version.repeat(64):null,width:1,height:1})}));await page.route('**/api/hero/*',route=>route.fulfill({status:200,contentType:'image/gif',body:fixture}));await page.goto(origin+'/tr');const image=page.locator('.hero-gif');await image.waitFor({state:'attached'});await page.waitForFunction(()=>{const i=document.querySelector('.hero-gif')as HTMLImageElement;return i?.complete&&i.naturalWidth>0;});
  if(reducedMotion==='reduce'){await page.locator('.hero-static[data-ready=true]').waitFor();assert.ok(await page.locator('.hero-static').evaluate((c:HTMLCanvasElement)=>c.getContext('2d')!.getImageData(0,0,1,1).data[3]>0));await page.getByRole('checkbox',{name:'Animasyonu duraklat',exact:true}).uncheck();assert.equal(await image.evaluate(el=>getComputedStyle(el).visibility),'visible');await page.getByRole('checkbox',{name:'Animasyonu duraklat',exact:true}).check();await page.locator('.hero-static[data-ready=true]').waitFor();}else assert.equal(await image.evaluate(el=>getComputedStyle(el).visibility),'visible');
  await page.screenshot({path:'.runtime/mobile-locale-v052/hero-'+width+'-'+reducedMotion+'.png'});version='2';await page.evaluate(()=>window.dispatchEvent(new Event('rewards-hero')));await page.waitForFunction(()=>document.querySelector('.hero-gif')?.getAttribute('src')?.includes('22222222'));published=false;await page.evaluate(()=>window.dispatchEvent(new Event('rewards-hero')));await page.waitForFunction(()=>!document.querySelector('.hero-gif'));assert.deepEqual(errors,[]);assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+2));await page.close();results.push({scenario:'hero-image-motion-and-refresh',width,reducedMotion,passed:true});
 }
 writeFileSync('.runtime/mobile-locale-v052/browser-results.json',JSON.stringify({results,nativePhoneAppLaunchTested:false,realTransfersPerformed:false},null,2));console.log('PASS '+results.length+' locale/mobile/SIWE/GIF cases; native app handoff verified as official URL only; no transfer');
}finally{
 await browser.close();for(const wallet of createdWallets){const user=await db.user.findUnique({where:{wallet}});if(user){assert.equal(await db.ledgerEntry.count({where:{userId:user.id}}),0);await db.auditEvent.deleteMany({where:{actor:user.id}});await db.user.delete({where:{id:user.id}});}}await db.$disconnect();
}
