  const callback=api.locator('[data-social-field]').filter({has:page.locator('input[name=redirectUri]')});await callback.getByRole('button',{name:lang==='tr'?'Adresi kopyala':'Copy URL',exact:true}).click();assert.equal(await page.evaluate(()=>navigator.clipboard.readText()),origin+'/api/oauth/'+platform.toLowerCase()+'/callback');await id.locator('summary').click();assert.ok(await id.locator('ol li').count()>=2);
