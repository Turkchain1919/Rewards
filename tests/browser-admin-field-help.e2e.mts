 }
 await page.goto(origin+'/'+lang+'/admin#social/accounts');const editor=page.locator('details').filter({has:page.locator('form input[name=accountId]')});await editor.locator('summary').first().click();await editor.locator('select[name=platform]').selectOption('TELEGRAM');await editor.getByText(lang==='tr'?'Telegram grup/kanal kimliği: -1003676977941 veya @Turkchain1919. Pozitif sayısal grup/kanal ID kabul edilmez.':'Telegram group/channel identity: -1003676977941 or @Turkchain1919. Positive numeric group/channel IDs are not accepted.',{exact:true}).waitFor();assert.notEqual(await editor.locator('input[name=accountId]').getAttribute('type'),'number');await editor.locator('select[name=platform]').selectOption('TIKTOK');await editor.locator('[data-help-field=accountId]').filter({hasText:'open_id'}).waitFor();
